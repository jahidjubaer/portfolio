# ============================================================================
#  SERVER ENVIRONMENT  (copy this file to server/.env and fill it in)
# ============================================================================
#
#  [REQUIRED]  must be set, or that feature does not work
#  [OPTIONAL]  safe to leave blank; the default or fallback is shown
#  [SECRET]    never commit it, never paste it in chat or screenshots
#
#  Locally the site runs with every OPTIONAL value blank. The REQUIRED
#  groups below only matter once you want that feature switched on.
#
#  Production (Vercel): set the same names under Project → Settings →
#  Environment Variables, with production values (see the notes).
# ============================================================================


# ----------------------------------------------------------------------------
#  1. Basic server settings
# ----------------------------------------------------------------------------

# [OPTIONAL] Port for the local API server. Default: 5000
PORT=5000

# [OPTIONAL] "development" locally. Vercel sets "production" by itself.
NODE_ENV=development

# [REQUIRED] Address of the website that is allowed to call this API.
#   Local:      http://localhost:5173
#   Production: your real site address, e.g. https://jahidhasan.dev
#   Admin sign-in and the CSRF check both depend on this being exact
#   (no trailing slash).
CLIENT_ORIGIN=http://localhost:5173


# ----------------------------------------------------------------------------
#  2. Content database: MongoDB Atlas  (R3)
#     Needed for: /api/public/* and the admin panel.
#     If blank: those endpoints answer 503 "not configured"; the public
#     site keeps working from its built-in content.
# ----------------------------------------------------------------------------

# [REQUIRED for database] [SECRET] Atlas connection string.
#   Get it: Vercel → Storage → MongoDB Atlas sets it automatically.
#   Locally: run `vercel env pull`, or paste it from Atlas → Connect.
#   Looks like: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
MONGODB_URI=

# [OPTIONAL] Database name inside the cluster. Default: portfolio
MONGODB_DB=portfolio


# ----------------------------------------------------------------------------
#  3. Admin sign-in with GitHub  (R4)
#     Needed for: /admin.
#     If any REQUIRED value is blank: /admin shows sign-in as unavailable
#     (the API answers 503 "not configured").
#
#     Create the app: GitHub → Settings → Developer settings → OAuth Apps
#     → New OAuth App. A GitHub OAuth App allows exactly ONE callback URL,
#     so make two apps:
#       Local app       Homepage: http://localhost:5173
#                       Callback: http://localhost:5000/api/auth/github/callback
#       Production app  Homepage: https://<your-domain>
#                       Callback: https://<your-domain>/api/auth/github/callback
# ----------------------------------------------------------------------------

# [REQUIRED for admin] Client ID shown on the OAuth App page (not secret).
GITHUB_CLIENT_ID=

# [REQUIRED for admin] [SECRET] Click "Generate a new client secret".
GITHUB_CLIENT_SECRET=

# [REQUIRED for admin] [SECRET] Signs the login cookie. At least 32
#   random characters, and a different value for local and production.
#   Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# [OPTIONAL] Only if the callback URL differs from this server's own
#   address (normally leave blank).
OAUTH_CALLBACK_URL=

# [OPTIONAL] GitHub account allowed into /admin, as its numeric user id.
#   Default: 139990599 (jahidjubaer). Leave blank unless that changes.
ADMIN_GITHUB_ID=


# ----------------------------------------------------------------------------
#  4. Uploads: Vercel Blob  (R5b)
#     Needed for: photo, post image, and resume PDF uploads in /admin.
#     If blank: uploads answer 503 "Uploads aren't configured"; everything
#     else in the admin keeps working.
#
#     Create it: Vercel → Storage → Create → Blob, access "Public", and
#     connect it to this project. Vercel then sets the token itself.
# ----------------------------------------------------------------------------

# [REQUIRED for uploads] [SECRET] Read-write token of the Blob store.
#   Locally: run `vercel env pull`, or copy it from the store's page.
#   Looks like: vercel_blob_rw_XXXXXXXX_YYYYYYYY
BLOB_READ_WRITE_TOKEN=


# ----------------------------------------------------------------------------
#  5. GitHub sync  (R6)
#     Needed for: the admin's Repositories page and live repo facts on the
#     site (language, last update, "Recently on GitHub").
#     Works WITHOUT a token, but GitHub then allows only 60 requests/hour.
#
#     Create the token: GitHub -> Settings -> Developer settings ->
#     Personal access tokens -> Fine-grained tokens -> Generate new token.
#       Repository access: "Public repositories (read-only)"
#       Permissions: none
#       Expiration: up to 1 year (put a reminder in your calendar)
# ----------------------------------------------------------------------------

# [OPTIONAL] [SECRET] Read-only fine-grained token. Looks like: github_pat_...
GITHUB_TOKEN=

# [OPTIONAL] Account whose public repositories are synced.
#   Default: jahidjubaer
GITHUB_USERNAME=

# [OPTIONAL] [SECRET] Protects the daily sync job (vercel.json "crons").
#   Vercel sends it to the job by itself once it is set in the project.
#   If blank: the daily job doesn't run; "Sync now" in /admin still works.
#   Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=


# ----------------------------------------------------------------------------
#  6. Publish: Vercel Deploy Hook  (R7)
#     Needed for: the "Publish" button in /admin, which rebuilds the public
#     site from the database (takes about 2 minutes).
#     If blank: Publish answers 503; the site still rebuilds on every push.
#
#     Create it: Vercel -> Project -> Settings -> Git -> Deploy Hooks ->
#     name "admin-publish", branch "main" -> Create Hook. Copy the URL.
# ----------------------------------------------------------------------------

# [REQUIRED for publish] [SECRET] Anyone with this URL can start a build.
#   Set it in Vercel (Production) and, to test locally, here.
#   Looks like: https://api.vercel.com/v1/integrations/deploy/prj_.../...
VERCEL_DEPLOY_HOOK_URL=
