PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Contact delivery. Both must be set in production for the contact form to
# actually deliver; if either is missing in production the API returns a
# controlled "temporarily unavailable" response instead of faking success.
# Leave blank in development/test — messages are simulated and only logged.
CONTACT_RECIPIENT_EMAIL=
CONTACT_PROVIDER=
