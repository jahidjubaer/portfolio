PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Contact delivery. All three must be set in production for the contact
# form to actually deliver; if any is missing in production the API returns
# a controlled "temporarily unavailable" response instead of faking success.
# Leave blank in development/test — messages are simulated and only logged.
# Web3Forms is the selected provider (CONTENT_CHECKLIST.md section 3) and is
# fully implemented in server/src/services/contactService.js — it only
# needs a real access key from https://web3forms.com to activate.
CONTACT_RECIPIENT_EMAIL=
CONTACT_PROVIDER=web3forms
WEB3FORMS_ACCESS_KEY=
