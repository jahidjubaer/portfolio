PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Blogger blog powering /learning. This is the SAME value as the client's
# VITE_BLOGGER_BLOG_URL (client/.env.example) — in production both the
# static build and this API read one shared Vercel environment variable
# pool, but in local dev the client and server are separate processes, so
# set this to the identical value in both .env files. Leave blank locally;
# /api/blog/posts then returns its honest "not configured" response.
# Example only — do not invent Jahid's real Blogger URL:
# VITE_BLOGGER_BLOG_URL=https://example.blogspot.com
