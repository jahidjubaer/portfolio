# Local development talks to the separate Express dev server on port 5000.
# In production, the frontend and /api/* share the same Vercel origin — set
# VITE_API_BASE_URL to an empty string there so client/src/lib/api.js makes
# same-origin relative requests (e.g. fetch("/api/contact")) instead.
VITE_API_BASE_URL=http://localhost:5000

# Absolute public base URL used for SEO canonical/OG/Twitter tags, the
# sitemap, and robots.txt. Falls back to the local dev origin when unset —
# set this to the real production URL once the site is deployed there.
VITE_SITE_URL=http://localhost:5173
