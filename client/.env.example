# Local development talks to the separate Express dev server on port 5000.
# In production, the frontend and /api/* share the same Vercel origin — set
# VITE_API_BASE_URL to an empty string there so client/src/lib/api.js makes
# same-origin relative requests (e.g. fetch("/api/health")) instead.
VITE_API_BASE_URL=http://localhost:5000

# Absolute public base URL used for SEO canonical/OG/Twitter tags, the
# sitemap, and robots.txt. Falls back to the local dev origin when unset —
# set this to the real production URL once the site is deployed there.
VITE_SITE_URL=http://localhost:5173

# Web3Forms access key for the contact form. Web3Forms's documented flow is
# client-side submission straight from the browser to their API (server-side
# calls require a paid plan and IP safelisting and are otherwise rejected),
# so this key ships in the built frontend bundle by design — Web3Forms access
# keys are not secret API keys. Leave blank in development; the contact form
# fails safely with a "temporarily unavailable" message when unset. Get a key
# from https://web3forms.com.
VITE_WEB3FORMS_ACCESS_KEY=
