# ============================================================================
#  CLIENT (WEBSITE) ENVIRONMENT  (copy this file to client/.env and fill it in)
# ============================================================================
#
#  [REQUIRED]  must be set, or that feature does not work
#  [OPTIONAL]  safe to leave blank; the default or fallback is shown
#
#  Every VITE_ value is built into the public website and anyone can read
#  it. Never put a password, database URL, or secret here; those belong in
#  server/.env only.
#
#  Production (Vercel): set the same names under Project → Settings →
#  Environment Variables, with the production values from the notes.
# ============================================================================


# [REQUIRED] Where the website sends API requests.
#   Local:      http://localhost:5000  (the Express dev server)
#   Production: leave it EMPTY (VITE_API_BASE_URL=) so requests go to the
#               same site, e.g. /api/health.
VITE_API_BASE_URL=http://localhost:5000

# [REQUIRED in production] The site's public address, used for Google/SEO
#   tags, link previews, sitemap.xml and robots.txt.
#   Local:      http://localhost:5173
#   Production: your real address, e.g. https://jahidhasan.dev
#   If blank: falls back to Vercel's address, then to localhost.
VITE_SITE_URL=http://localhost:5173

# [REQUIRED for the contact form] Web3Forms access key (free key from
#   https://web3forms.com). This key is designed to be public, so it is
#   safe here.
#   If blank: the form says "temporarily unavailable" and shows your email.
VITE_WEB3FORMS_ACCESS_KEY=

